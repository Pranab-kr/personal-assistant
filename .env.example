# Server (Railway / Hono)
PORT=3000
APP_BASE_URL=https://your-app.up.railway.app

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk (Device Authorization Grant OAuth app)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=
# Optional override (derived automatically from CLERK_PUBLISHABLE_KEY if omitted)
# CLERK_FRONTEND_API_URL=
# Optional override for hosted Account Portal /user/billing link (derived from Clerk FAPI if omitted)
# CLERK_ACCOUNT_PORTAL_URL=
# Optional override for required Clerk Billing plan slug (defaults to "pro")
# CLERK_REQUIRED_PLAN_SLUG=pro

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_WEBHOOK_ENDPOINT_ID=telegram
# Optional: separate secret between Hono -> Trigger.dev webhook (defaults to TELEGRAM_WEBHOOK_SECRET)
# TRIGGER_WEBHOOK_SECRET=
# Optional: pin Trigger.dev webhook URL directly instead of resolving via API
# TRIGGER_TELEGRAM_WEBHOOK_URL=

# AI / Tools (Trigger.dev agent)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.xkiro.com/v1
OPENAI_MODEL=
FIRECRAWL_API_KEY=
DAYTONA_API_KEY=
TRANSCRIPT_STORAGE_DIR=.data/transcripts
